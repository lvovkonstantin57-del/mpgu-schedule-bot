# Прокси для связи с Telegram. Если не нужен — оставьте пустым.
# Формат:  socks5://ЛОГИН:ПАРОЛЬ@АДРЕС:ПОРТ   или   http://ЛОГИН:ПАРОЛЬ@АДРЕС:ПОРТ
PROXY_URL=

# Адрес этого сервера: через него приложение получает расписание (HTTPS настраивается сам)
